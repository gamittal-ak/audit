# Copy this to .env and fill in your values

# App secret key - use a long random string
SECRET_KEY=change-me-to-a-long-random-secret

# Login password for the web UI
APP_PASSWORD=change-me

# Redis URL (matches docker-compose service name)
REDIS_URL=redis://redis:6379/0

# Path to your Akamai .edgerc file (mounted as a Docker volume)
EDGERC_HOST_PATH=./.edgerc
EDGERC_PATH=/run/secrets/edgerc
EDGERC_SECTION=default
EDGERC_REPORTING_SECTION=reporting

# Directory where reports are saved (bind-mounted volume)
REPORTS_BASE_DIR=/app/reports

# Concurrent work slots; actual API request rates are paced separately
CONCURRENCY_LIMIT=10

# Rule tree cache TTL in seconds (1 hour)
RULE_TREE_CACHE_TTL=3600

# Reporting API traffic query controls
# Chunking prevents one large account request or one unauthorized CPCode from losing all traffic data.
TRAFFIC_CHUNK_SIZE=100
TRAFFIC_CHUNK_DELAY_SECONDS=0.25
TRAFFIC_MAX_RETRIES=6

# Shared across FastAPI and Celery processes, accounts, and credential sections.
# Values may be lowered; validation prevents raising them beyond these safe caps.
PAPI_REQUESTS_PER_MINUTE=80
REPORTING_REQUESTS_PER_MINUTE=15
AKAMAI_GLOBAL_REQUESTS_PER_SECOND=2
AKAMAI_MAX_ATTEMPTS=6
AKAMAI_WAF_COOLDOWN_SECONDS=610
