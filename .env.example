# Copy this to .env and fill in your values

# App secret key - use a long random string
SECRET_KEY=change-me-to-a-long-random-secret

# Login password for the web UI
APP_PASSWORD=change-me

# Redis URL (matches docker-compose service name)
REDIS_URL=redis://redis:6379/0

# Path to your Akamai .edgerc file (mounted as a Docker volume)
EDGERC_PATH=/run/secrets/edgerc
EDGERC_SECTION=default

# Directory where reports are saved (bind-mounted volume)
REPORTS_BASE_DIR=/app/reports

# Max concurrent Akamai API calls (tune to avoid 429s)
CONCURRENCY_LIMIT=10

# Rule tree cache TTL in seconds (1 hour)
RULE_TREE_CACHE_TTL=3600
